<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="#FDFBF8"
    tools:context=".student.StudentDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#7B1113">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnProfile"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="4dp"
                    android:background="@android:color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_profile"
                        android:layout_gravity="center"
                        app:tint="#7B1113" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDashboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Student!"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tvUserInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Section: Loading..."
                        android:textSize="14sp"
                        android:textColor="#E8E8E8" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="LOGOUT"
                    android:textColor="#7B1113"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="#7B1113" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSchedulePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_schedule"
                        android:layout_marginEnd="8dp"
                        app:tint="#7B1113" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Today's Schedule"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#7B1113" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FBEFEF"
                    app:strokeColor="#7B1113"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily Notes"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:letterSpacing="0.06"
                            android:paddingBottom="4dp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="The future belongs to those who believe in the beauty of their dreams. - Eleanor Roosevelt"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#9B1C1F"
                        android:letterSpacing="0.1" />


                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TableLayout
                    android:id="@+id/tlDailySchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2">

                    <TableRow
                        android:background="#FBEFEF"
                        android:padding="8dp">

                        <TextView
                            android:text="Time"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:textSize="12sp"
                            android:textColor="#7B1113"/>
                        <TextView
                            android:text="Subject"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:textSize="14sp"
                            android:textColor="#7B1113"/>
                        <TextView
                            android:text="Roon"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:textSize="14sp"
                            android:textColor="#7B1113"/>
                    </TableRow>

                    <TextView
                        android:id="@+id/tvScheduleStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No Class for Today!"
                        android:gravity="center"
                        android:padding="20dp"
                        android:layout_span="3"
                        android:textColor="#888888" />

                </TableLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_academic"
                        android:layout_marginEnd="8dp"
                        app:tint="#7B1113" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACADEMIC TOOLS"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#7B1113" />
                </LinearLayout>

                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="3"
                    app:rowCount="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubjects"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_margin="4dp"
                        android:text="Subjects"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#7B1113"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_subjects"
                        app:iconGravity="textTop"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_gravity="fill"
                        app:layout_row="0"
                        app:layout_rowWeight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrades"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Grades"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_grades"
                        app:iconGravity="textTop"
                        app:backgroundTint="#9B1C1F"
                        android:textColor="@android:color/white"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuizzes"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Quizzes"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_quiz"
                        app:iconGravity="textTop"
                        app:backgroundTint="#7B1113"
                        android:textColor="@android:color/white"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExam"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Exam"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_exam"
                        app:iconGravity="textTop"
                        app:backgroundTint="#9B1C1F"
                        android:textColor="@android:color/white"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="1"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSchedule"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Full Schedule"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_schedule"
                        app:iconGravity="textTop"
                        app:backgroundTint="#7B1113"
                        android:textColor="@android:color/white"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="1"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAttendance"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Attendance"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_attendance"
                        app:iconGravity="textTop"
                        app:backgroundTint="#9B1C1F"
                        android:textColor="@android:color/white"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_row="1"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                </androidx.gridlayout.widget.GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_productivity"
                        android:layout_marginEnd="8dp"
                        app:tint="#7B1113" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PRODUCTIVITY &amp; E-LEARNING"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#7B1113" />
                </LinearLayout>

                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="3"
                    app:rowCount="1">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOnlineClasses"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Online Classes"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_online_class"
                        app:iconGravity="textTop"
                        app:backgroundTint="#7B1113"
                        android:textColor="@android:color/white"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToDoList"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="To-Do List"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_todo"
                        app:iconGravity="textTop"
                        app:backgroundTint="#9B1C1F"
                        android:textColor="@android:color/white"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotes"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Notes"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_notes"
                        app:iconGravity="textTop"
                        app:backgroundTint="#7B1113"
                        android:textColor="@android:color/white"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                </androidx.gridlayout.widget.GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_campus"
                        android:layout_marginEnd="8dp"
                        app:tint="#7B1113" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CAMPUS SERVICES"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#7B1113" />
                </LinearLayout>

                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="3"
                    app:rowCount="1">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCanteen"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:text="Canteen"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_canteen"
                        app:iconGravity="textTop"
                        app:backgroundTint="#9B1C1F"
                        android:textColor="@android:color/white"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        app:layout_gravity="fill"
                        android:layout_margin="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        android:visibility="invisible" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        app:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        android:visibility="invisible" />

                </androidx.gridlayout.widget.GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>