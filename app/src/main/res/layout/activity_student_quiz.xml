<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewQuiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FDFBF8">

    <LinearLayout
        android:id="@+id/quizRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#7B1113">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Question Counter & Timer Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvQuestionCounter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Question 1 of 10"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        tools:text="Question 1 of 10" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:drawableStart="@drawable/ic_timer"
                        android:drawablePadding="8dp"
                        android:drawableTint="@android:color/white"
                        tools:text="05:00" />

                </LinearLayout>

                <!-- Cheat Counter -->
                <TextView
                    android:id="@+id/tvCheatCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cheat attempts: 0/5"
                    android:textSize="14sp"
                    android:textColor="#FFBABA"
                    tools:text="Cheat attempts: 0/5" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Question Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Question Type -->
                <TextView
                    android:id="@+id/tvQuestionType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multiple Choice"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#7B1113"
                    android:background="#FBEFEF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="12dp"
                    tools:text="Multiple Choice" />

                <!-- Question Text -->
                <TextView
                    android:id="@+id/tvQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What is the question text that will appear here for the student to read and answer?"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:lineSpacingExtra="6dp"
                    tools:text="What is the question text that will appear here for the student to read and answer?" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Options Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Multiple Choice Options -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Option 1 will appear here"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="#DDDDDD"
                    app:cornerRadius="8dp"
                    tools:text="Option 1 will appear here" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Option 2 will appear here"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="#DDDDDD"
                    app:cornerRadius="8dp"
                    tools:text="Option 2 will appear here" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Option 3 will appear here"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="#DDDDDD"
                    app:cornerRadius="8dp"
                    tools:text="Option 3 will appear here" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Option 4 will appear here"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="#DDDDDD"
                    app:cornerRadius="8dp"
                    tools:text="Option 4 will appear here" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Matching Layout Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/matchingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/matchingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next Question"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="14dp"
            app:backgroundTint="#7B1113"
            app:cornerRadius="12dp"
            tools:text="Next Question" />

    </LinearLayout>
</ScrollView>