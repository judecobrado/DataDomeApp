<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FDFBF8">

    <!-- HEADER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Task"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#7B1113"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:letterSpacing="0.02"/>

    <!-- TITLE INPUT -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#E8E8E8"
        app:strokeWidth="1dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Task Title"
            app:hintTextColor="#7B1113"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#7B1113"
            app:endIconMode="clear_text"
            app:endIconTint="#7B1113">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:maxLength="100"
                android:textColor="#333333"
                android:textSize="16sp"/>

        </com.google.android.material.textfield.TextInputLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- DETAILS INPUT -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#E8E8E8"
        app:strokeWidth="1dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Task Details (Optional)"
            app:hintTextColor="#7B1113"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#7B1113">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetails"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:maxLines="5"
                android:textColor="#333333"
                android:textSize="16sp"
                android:padding="16dp"/>

        </com.google.android.material.textfield.TextInputLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- DATE &amp; TIME SECTION -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#E8E8E8"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Due Date &amp; Time"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#7B1113"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Select Date"
                    android:textSize="14sp"
                    android:paddingVertical="12dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:strokeColor="#7B1113"
                    app:strokeWidth="1dp"
                    app:backgroundTint="@android:color/transparent"
                    android:textColor="#7B1113"
                    app:iconTint="#7B1113"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Select Time"
                    android:textSize="14sp"
                    android:paddingVertical="12dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_clock"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:strokeColor="#7B1113"
                    app:strokeWidth="1dp"
                    app:backgroundTint="@android:color/transparent"
                    android:textColor="#7B1113"
                    app:iconTint="#7B1113"/>

            </LinearLayout>

            <!-- SELECTED DATE &amp; TIME DISPLAY -->
            <TextView
                android:id="@+id/tvSelectedDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No date and time set"
                android:textSize="12sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:background="#FBEFEF"
                android:visibility="gone"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>