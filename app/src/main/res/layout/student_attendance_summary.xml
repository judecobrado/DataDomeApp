<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDFBF8"
    tools:context=".student.StudentAttendanceActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#7B1113">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:gravity="center">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_attendance_header"
                android:layout_marginBottom="8dp"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attendance Summary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:letterSpacing="0.02"/>

            <TextView
                android:id="@+id/tvAttendanceStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&quot;Be present, learn more.&quot;"
                android:textSize="14sp"
                android:textColor="#E8E8E8"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#E8E8E8"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter by Grading Period:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#7B1113"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#7B1113"
                    android:textColor="@android:color/white"
                    app:chipCornerRadius="8dp"
                    app:checkedIcon="@null"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPrelim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prelim"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#FBEFEF"
                    android:textColor="#7B1113"
                    app:chipCornerRadius="8dp"
                    app:checkedIcon="@null"
                    android:layout_marginStart="8dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMidterm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Midterm"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#FBEFEF"
                    android:textColor="#7B1113"
                    app:chipCornerRadius="8dp"
                    app:checkedIcon="@null"
                    android:layout_marginStart="8dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFinals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finals"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#FBEFEF"
                    android:textColor="#7B1113"
                    app:chipCornerRadius="8dp"
                    app:checkedIcon="@null"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAttendanceSummary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_student_attendance_summary" />

    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#7B1113"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading attendance data..."
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_empty_attendance"
            android:layout_marginBottom="24dp"
            app:tint="#CCCCCC" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Attendance Records"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your attendance records will appear here"
            android:textSize="16sp"
            android:textColor="#888888"
            android:gravity="center"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_error"
            android:layout_marginBottom="24dp"
            app:tint="#FF6B6B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unable to Load Data"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="There was an error loading your attendance records"
            android:textSize="16sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try Again"
            android:textSize="14sp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            app:cornerRadius="8dp"
            app:backgroundTint="#7B1113"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</LinearLayout>