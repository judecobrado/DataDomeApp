<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_main"/>

    <!-- Particle / Sparkle container -->
    <FrameLayout
        android:id="@+id/particleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Logo behind the doors -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerInParent="true"
        android:src="@raw/dd_logo"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:elevation="8dp"/>

    <!-- Left door -->
    <View
        android:id="@+id/doorLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="#800000"
        android:layout_toStartOf="@id/imgLogo"/>

    <!-- Right door -->
    <View
        android:id="@+id/doorRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="#800000"
        android:layout_toEndOf="@id/imgLogo"/>

    <!-- Light streak overlay -->
    <View
        android:id="@+id/lightStreak"
        android:layout_width="50dp"
        android:layout_height="150dp"
        android:layout_centerInParent="true"
        android:background="@drawable/light_streak"
        android:rotation="45"
        android:alpha="0"/>
</RelativeLayout>
