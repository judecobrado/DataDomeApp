<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".teacher.RecordAttendanceActivity">

    <TextView
        android:id="@+id/tvAttendanceHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record Attendance"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Timer Display -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="01:00:00"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@color/green"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSessionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Session Info"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Date Selection Only - No Time Slot -->
    <EditText
        android:id="@+id/etAttendanceDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Petsa (YYYY-MM-DD)"
        android:focusable="false"
        android:clickable="true"
        android:inputType="date"
        android:drawableEnd="@android:drawable/ic_menu_today"
        android:layout_marginBottom="16dp"/>

    <!-- ID Tapping Button -->
    <Button
        android:id="@+id/btnStartIdTapping"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Class Session 🟢"
        android:backgroundTint="@color/green"/>

    <!-- ATTENDANCE LEGEND - COLOR BASE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="5dp"
        android:padding="5dp">

        <!-- Present - Light Green -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="12dp"
            android:background="@color/status_present"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:backgroundTint="@color/status_present">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Present"
                android:textSize="12sp"
                android:textColor="@color/status_present_text"/>
        </LinearLayout>

        <!-- Late - Light Yellow -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="12dp"
            android:background="@color/status_late"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:backgroundTint="@color/status_late">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Late"
                android:textSize="12sp"
                android:textColor="@color/status_late_text"/>
        </LinearLayout>

        <!-- Absent - Light Red -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="12dp"
            android:background="@color/status_absent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:backgroundTint="@color/status_absent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Absent"
                android:textSize="12sp"
                android:textColor="@color/status_absent_text"/>
        </LinearLayout>

        <!-- Excused - Light Blue -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/status_excused"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:backgroundTint="@color/status_excused">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excused"
                android:textSize="12sp"
                android:textColor="@color/status_excused_text"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoRecords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No students found for this class."
        android:textAlignment="center"
        android:padding="16dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAttendance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        tools:listitem="@layout/teacher_item_attendance_student"/>

    <Button
        android:id="@+id/btnSaveAttendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Class Session"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnViewOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Session Overview"
        android:layout_marginTop="8dp"/>

</LinearLayout>