<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:padding="16dp"
    tools:context=".teacher.RecordAttendanceActivity">

    <!-- Header Section - COMPACT -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#7B1113"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAttendanceHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Record Attendance"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage class sessions"
                android:textSize="12sp"
                android:gravity="center"
                android:textColor="#E8E8E8"
                android:alpha="0.9"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Timer Display Card - COMPACT -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/timerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#2E7D32"
        android:layout_marginBottom="12dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_timer"
                android:layout_marginEnd="8dp"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="01:00:00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>

            <TextView
                android:id="@+id/tvSessionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Progress"
                android:textSize="12sp"
                android:textColor="#E8F5E8"
                android:alpha="0.9"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Date Selection Card - COMPACT -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:strokeColor="#E8E8E8"
        app:strokeWidth="1dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="6dp"
                app:boxCornerRadiusBottomStart="6dp"
                app:boxCornerRadiusTopEnd="6dp"
                app:boxCornerRadiusTopStart="6dp"
                app:boxStrokeColor="#7B1113"
                app:hintTextColor="#666666"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAttendanceDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Session Date (YYYY-MM-DD)"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="date"
                    android:textSize="14sp"
                    app:startIconDrawable="@drawable/ic_calendar"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Start Session Card - COMPACT -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:strokeColor="#E8E8E8"
        app:strokeWidth="1dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartIdTapping"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Start Class Session"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_play_circle"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:cornerRadius="8dp"
                app:backgroundTint="#2E7D32"
                android:textColor="@android:color/white"
                app:iconTint="@android:color/white"
                style="@style/Widget.Material3.Button"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Students List Card - MAXIMIZED SPACE -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white"
        app:strokeColor="#E8E8E8"
        app:strokeWidth="1dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- List Header - COMPACT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#F8F9FA">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_group"
                    android:layout_marginEnd="8dp"
                    app:tint="#7B1113" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Student Attendance"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <!-- FIXED: Replaced TextView with cornerRadius to MaterialCardView -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E8E8E8"
                    app:strokeColor="#E8E8E8"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tvStudentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"/>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_empty_students"
                    android:alpha="0.5"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvNoRecords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No students found"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#999999"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start session to view students"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="#999999"/>

            </LinearLayout>

            <!-- Students RecyclerView - MAXIMIZED -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAttendance"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:clipToPadding="false"
                tools:listitem="@layout/teacher_item_attendance_student"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons - COMPACT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAttendance"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Save Session"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:cornerRadius="8dp"
            app:backgroundTint="#7B1113"
            android:textColor="@android:color/white"
            android:layout_marginEnd="6dp"
            style="@style/Widget.Material3.Button"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewOverview"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Overview"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_summary"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:cornerRadius="8dp"
            app:strokeColor="#7B1113"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent"
            android:textColor="#7B1113"
            android:layout_marginStart="6dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

    </LinearLayout>

</LinearLayout>