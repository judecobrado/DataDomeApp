<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/background_cream"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:weightSum="100"
        android:background="@color/background_cream">

        <!-- Left Section - Student Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="60"
            android:orientation="vertical">

            <!-- Student Name -->
            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juan Dela Cruz"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/primary_maroon"
                android:layout_marginBottom="4dp"/>

            <!-- Student ID -->
            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DDS-2023-0001"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp"
                tools:text="DDS-2023-0001"/>

            <!-- Status with colored indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_indicator_active"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAKING QUIZ"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- Last Update -->
            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updated: May 20, 10:30 AM"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"/>
        </LinearLayout>

        <!-- Right Section - Scores & Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="40"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Score -->
            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15/20"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_maroon"
                android:layout_marginBottom="4dp"/>

            <!-- Cheats Counter -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:background="@drawable/cheats_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvCheats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cheats: 2"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <!-- View Integrity Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewIntegrity"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="Logs"
                    android:textSize="12sp"
                    app:strokeColor="@color/secondary_red"
                    app:icon="@drawable/ic_history"
                    app:iconTint="@color/secondary_red"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:textColor="@color/secondary_red"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <!-- Access Control Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccessControl"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Access"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_lock"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:backgroundTint="@color/secondary_red"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>