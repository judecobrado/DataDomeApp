<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Classroom Noise Monitor"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Noise level -->
    <TextView
        android:id="@+id/tvNoiseStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Current Noise: 0 dB"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#4B5563"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/noiseProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:max="100"
        android:progress="0"
        android:backgroundTint="#E5E7EB"
        android:layout_marginTop="16dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/tvNoiseStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- dB Labels -->
    <LinearLayout
        android:id="@+id/dbScaleLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/noiseProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="50 dB (Quiet)"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:gravity="start"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100 dB (Loud)"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Threshold Adjustment Section -->
    <TextView
        android:id="@+id/tvThresholdLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Noise Threshold: 75 dB"
        android:textSize="16sp"
        android:textColor="#800000"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/dbScaleLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Threshold SeekBar -->
    <SeekBar
        android:id="@+id/thresholdSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="40"
        android:progress="25"
        android:progressTint="#800000"
        android:thumbTint="#800000"
        app:layout_constraintTop_toBottomOf="@id/tvThresholdLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Threshold Min Max Labels -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/thresholdSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="60 dB"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:gravity="start"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="120 dB"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Music system status -->
    <TextView
        android:id="@+id/tvMusicStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Voice Detection: ACTIVE"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/thresholdSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Calibrate Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalibrate"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="CALIBRATE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:backgroundTint="#FFFFFF"
        android:strokeColor="#800000"
        android:strokeWidth="0.2"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMusicStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Status Info -->
    <TextView
        android:id="@+id/tvStatusInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Monitoring classroom noise level"
        android:textSize="14sp"
        android:textColor="#9CA3AF"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnCalibrate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>