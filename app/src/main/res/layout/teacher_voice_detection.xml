<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Classroom Noise Monitor"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Noise level -->
    <TextView
        android:id="@+id/tvNoiseStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Current Noise: 0 dB"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#4B5563"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/noiseProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:max="100"
        android:progress="0"
        android:backgroundTint="#E5E7EB"
        android:layout_marginTop="16dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/tvNoiseStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- dB Labels -->
    <LinearLayout
        android:id="@+id/dbScaleLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/noiseProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="50 dB (Quiet)"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:gravity="start"/>

        <TextView
            android:id="@+id/tvThreshold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Target: 90 dB"
            android:textSize="12sp"
            android:textColor="#800000"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Music system status -->
    <TextView
        android:id="@+id/tvMusicStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Music System: DISABLED"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/dbScaleLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"/>

    <!-- Start/Stop Monitoring button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleDetection"
        android:layout_width="0dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_height="56dp"
        android:text="START MONITORING"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#800000"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMusicStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- ✅ NEW: Calibrate Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalibrate"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="CALIBRATE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:backgroundTint="#FFFFFF"
        android:strokeColor="#800000"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/toggleDetection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
