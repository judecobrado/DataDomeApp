<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@android:color/white"
    android:gravity="center">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noise Monitor"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#800000"
        android:layout_marginBottom="48dp"/>

    <!-- Current Noise Level -->
    <TextView
        android:id="@+id/tvNoiseStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="45 dB"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#2D3748"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Noise Level"
        android:textSize="14sp"
        android:textColor="#718096"
        android:layout_marginBottom="32dp"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/noiseProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:max="100"
        android:progress="45"
        android:progressTint="#800000"
        android:backgroundTint="#E2E8F0"
        android:layout_marginBottom="8dp"/>

    <!-- dB Scale -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quiet"
            android:textSize="12sp"
            android:textColor="#718096"
            android:gravity="start"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loud"
            android:textSize="12sp"
            android:textColor="#718096"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Threshold Section -->
    <TextView
        android:id="@+id/tvThresholdLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Threshold: 75 dB"
        android:textSize="16sp"
        android:textColor="#800000"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Threshold SeekBar -->
    <SeekBar
        android:id="@+id/thresholdSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="40"
        android:progress="25"
        android:progressTint="#800000"
        android:thumbTint="#800000"
        android:layout_marginBottom="8dp"/>

    <!-- Threshold Labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="60 dB"
            android:textSize="12sp"
            android:textColor="#718096"
            android:gravity="start"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="120 dB"
            android:textSize="12sp"
            android:textColor="#718096"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/tvMusicStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔊 Monitoring Active"
        android:textSize="16sp"
        android:textColor="#4A5568"
        android:layout_marginBottom="16dp"/>


    <!-- Status Info -->
    <TextView
        android:id="@+id/tvStatusInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitoring classroom environment"
        android:textSize="14sp"
        android:textColor="#A0AEC0"
        android:gravity="center"/>

</LinearLayout>