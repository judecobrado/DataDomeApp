<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Student Scores"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- ADD: Edit Button -->
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:textSize="14sp" />

        <!-- Attendance Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attendance"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etAttendancePresent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Present days"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:enabled="false"
                    android:alpha="0.6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:padding="8dp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etAttendanceTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Total sessions"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:enabled="false"
                    android:alpha="0.6" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAttendancePercentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Percentage: 0%"
                android:textSize="12sp"
                android:textColor="#666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Recitation Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recitation"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etRecitationPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Total recitation points"
                android:inputType="number"
                android:textSize="14sp"
                android:enabled="false"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/tvRecitationPercentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Percentage: 0%"
                android:textSize="12sp"
                android:textColor="#666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Quiz Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz Scores"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuizScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Exam Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exam Scores"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExamScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Assignment Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assignment Scores"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAssignmentScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>