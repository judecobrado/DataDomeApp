<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF8"
    android:scrollbars="none"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#666666"
            android:text="Back to Dashboard"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="#FFFFFF" />

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="24dp"
            android:paddingTop="10dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_teacher"
                android:layout_marginEnd="12dp"
                app:tint="#7B1113" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teacher Management"
                    android:textColor="#7B1113"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Manage teacher records and profiles"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search & Filter Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#9B1C1F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="12dp"
                        app:tint="#7B1113" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search and Filter"
                        android:textColor="#7B1113"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Search Input - CHANGED TO SEARCHVIEW -->
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchViewTeachers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:queryHint="Search by Name, ID, or RFID Tag..."
                    android:iconifiedByDefault="false"
                    app:queryBackground="@android:color/transparent"
                    app:searchHintIcon="@drawable/ic_search"
                    app:closeIcon="@drawable/ic_close" />

                <!-- Filter Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Department Filter -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Department"
                            android:textColor="#7B1113"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#7B1113"
                            app:strokeWidth="1dp">

                            <Spinner
                                android:id="@+id/spDepartmentFilter"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@android:color/transparent"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#333333" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Status Filter -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Status"
                            android:textColor="#7B1113"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#7B1113"
                            app:strokeWidth="1dp">

                            <Spinner
                                android:id="@+id/spinnerFilterStatus"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@android:color/transparent"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#333333" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Teachers List Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#9B1C1F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_group"
                        android:layout_marginEnd="12dp"
                        app:tint="#7B1113" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teacher Records"
                        android:textColor="#7B1113"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTeacherCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_count_badge_maroon"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="0 teachers"
                        android:textColor="#7B1113"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddTeacher"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#7B1113"
                        android:text="Add New Teacher"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_add"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteTeacher"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#D32F2F"
                        android:text="Delete Selected"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>

                <!-- Teachers ListView -->
                <ListView
                    android:id="@+id/lvTeachers"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#F8F8F8"
                    android:padding="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>