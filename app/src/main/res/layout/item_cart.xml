<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#7B1113"  app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvCartItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Special Chicken Adobo"
                android:textSize="17sp"
                android:textStyle="normal"
                android:textColor="#333333"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvCartItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="₱250.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#7B1113" android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#7B1113"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="0dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="-"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#7B1113" android:backgroundTint="#FFFFFF"
                    app:cornerRadius="0dp"
                    android:padding="0dp"
                    app:rippleColor="#FCD6D6"
                    app:strokeWidth="0dp" />

                <TextView
                    android:id="@+id/tvCartItemQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    tools:text="1"
                    android:minWidth="30dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1F1F1F"
                    android:background="#F0F0F0"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#7B1113" android:backgroundTint="#FFFFFF"
                    app:cornerRadius="0dp"
                    android:padding="0dp"
                    app:rippleColor="#FCD6D6"
                    app:strokeWidth="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ImageButton
            android:id="@+id/btnRemoveItem"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#7B1113" android:background="@android:color/transparent"
            android:contentDescription="Remove Item"
            android:padding="4dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>