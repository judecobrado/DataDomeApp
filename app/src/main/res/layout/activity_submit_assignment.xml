<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FDFBF8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Assignment Title -->
        <TextView
            android:id="@+id/tvAssignmentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assignment Submission"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="#7B1113" />

        <!-- Due Date -->
        <TextView
            android:id="@+id/tvDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Due: Loading..."
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:textStyle="italic"
            android:textColor="#7B1113" />

        <!-- Submission Status -->
        <TextView
            android:id="@+id/tvSubmissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking submission status..."
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#FDFBF8"
            android:layout_marginBottom="16dp"
            android:textColor="#7B1113" />

        <!-- Notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submission Notes (Optional)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="#7B1113" />

        <EditText
            android:id="@+id/etSubmissionNote"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Add any notes about your submission..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:textColor="#7B1113"
            android:textColorHint="#9B1C1F" />

        <!-- File Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submission File"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="#7B1113" />

        <TextView
            android:id="@+id/tvSelectedFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file selected"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:textColor="#7B1113" />

        <Button
            android:id="@+id/btnChooseSubmission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose File"
            android:backgroundTint="#7B1113"
            android:textColor="#FDFBF8"
            android:layout_marginBottom="16dp" />

        <!-- Submitted File Section (Shows after submission) -->
        <TextView
            android:id="@+id/tvSubmittedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uploaded File: "
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#FDFBF8"
            android:layout_marginBottom="8dp"
            android:textColor="#7B1113"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOpenFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open File"
            android:backgroundTint="#9B1C1F"
            android:textColor="#FDFBF8"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitAssignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submittttt"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:backgroundTint="#7B1113"
            android:textColor="#FDFBF8"
            android:layout_marginBottom="16dp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#7B1113" />

    </LinearLayout>
</ScrollView>