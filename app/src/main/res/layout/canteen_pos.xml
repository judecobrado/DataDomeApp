<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:focusableInTouchMode="true" tools:context=".canteen.POSActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"  android:paddingTop="16dp">

        <LinearLayout
            android:id="@+id/focus_dummy_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="CANTEEN POS SYSTEM"
                android:textColor="#7B1113"
                android:textSize="24sp"           android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="0dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"  app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#7B1113"
                app:hintTextColor="#7B1113"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="#7B1113"
                android:hint="Search menu items..."
                app:boxStrokeWidth="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp"           android:paddingVertical="8dp"
                    android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="18dp"        app:cardElevation="4dp"            app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#7B1113"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMenuPOS"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:scrollbars="vertical"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="3"
                        tools:listitem="@layout/item_menu_pos" />

                    <ProgressBar
                        android:id="@+id/pbMenuLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="#7B1113"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvNoResults"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No menu items found"
                        android:textColor="#9B1C1F"
                        android:textSize="16sp"
                        android:layout_gravity="center"
                        android:padding="16dp"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"         app:cardElevation="8dp"             app:cardBackgroundColor="#FFFFFF"
            android:layout_marginTop="8dp"
            app:strokeColor="#7B1113"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ORDER CART"
                    android:textStyle="bold"
                    android:textSize="18sp"         android:textColor="#7B1113"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCart"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"    android:scrollbars="vertical"
                    android:background="@android:color/transparent"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="12dp" tools:listitem="@layout/item_cart" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"       android:background="#E0E0E0"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL AMOUNT DUE:"
                        android:textStyle="bold"
                        android:textSize="16sp"           android:textColor="#1F1F1F" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textStyle="bold"
                        android:textSize="20sp"           android:textColor="#7B1113"
                        android:fontFamily="sans-serif-black"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelOrder"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="CANCEL"
                        android:textStyle="bold"
                        android:textSize="14sp"           android:backgroundTint="#FFFFFF"
                        app:cornerRadius="16dp"             android:textColor="#9B1C1F"
                        app:strokeColor="#9B1C1F"
                        app:strokeWidth="2dp"
                        app:rippleColor="#FCD6D6"
                        android:layout_marginEnd="6dp"    app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckout"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="CHECKOUT"
                        android:textStyle="bold"
                        android:textSize="14sp"           android:backgroundTint="#7B1113"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="16dp"             app:rippleColor="#FFFFFF"
                        android:layout_marginStart="6dp"   app:elevation="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llNfcPrompt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#A0F0F0F0"
        android:translationZ="100dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"           app:cardElevation="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#7B1113"
            app:strokeWidth="3dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp">
                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="50dp"     android:layout_height="50dp"
                    android:indeterminateTint="#7B1113"
                    android:layout_marginBottom="20dp" />
                <TextView
                    android:id="@+id/tvNfcPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AWAITING RFID SCAN"
                    android:textColor="#7B1113"
                    android:textStyle="bold"
                    android:textSize="20sp"        android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please tap the card to complete payment."
                    android:textColor="#757575"
                    android:textSize="15sp"        android:gravity="center"
                    android:paddingTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>