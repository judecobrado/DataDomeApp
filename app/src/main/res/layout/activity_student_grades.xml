<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grade Summary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvLoadingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading grades..."
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:textColor="#666666" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewGrades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Grading System Reference - Table Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grading System"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="#333333" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:shrinkColumns="*">

            <!-- Row 1 -->
            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1.00 = 99-100%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2.25 = 84-86%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
            </TableRow>

            <!-- Row 2 -->
            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1.25 = 97-98%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2.50 = 81-83%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
            </TableRow>

            <!-- Row 3 -->
            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1.50 = 94-96%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2.75 = 78-80%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
            </TableRow>

            <!-- Row 4 -->
            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1.75 = 90-93%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3.00 = 75-77%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
            </TableRow>

            <!-- Row 5 -->
            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2.00 = 87-89%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5.00 = Below 75%"
                    android:textSize="10sp"
                    android:padding="2dp"
                    android:textColor="#666666" />
            </TableRow>

        </TableLayout>

    </LinearLayout>

</LinearLayout>