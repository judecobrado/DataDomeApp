<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_color"
    tools:context=".teacher.GradeInputActivity">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvGradeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[Period] Grades - [Class Name]"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:background="@drawable/header_background"
        android:textColor="@color/white"
        android:layout_marginBottom="15dp"
        android:elevation="4dp"/>

    <!-- Status Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp"
        android:padding="16dp"
        android:background="@drawable/status_background"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading student data..."
            android:textSize="15sp"
            android:textColor="@color/maroon_dark"
            android:textStyle="normal"
            android:letterSpacing="0.02"/>
    </LinearLayout>



    <!-- Current Grade Weights Display -->
    <LinearLayout
        android:id="@+id/llGradeWeights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/weights_background"
        android:padding="10dp"
        android:layout_marginBottom="15dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CURRENT GRADE WEIGHTS"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/maroon_primary"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Attendance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvAttendanceWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Recitation -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvRecitationWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recitation"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Quiz -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvQuizWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiz"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Assignment -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvAssignmentWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assessment"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Exam -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvExamWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exam"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Total Percentage -->
        <TextView
            android:id="@+id/tvTotalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: 100%"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:background="@color/good_green"
            android:padding="4dp"
            android:backgroundTint="@color/good_green"/>

        <Button
            android:id="@+id/btnConfigureWeights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Weights"
            android:textSize="11sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:minHeight="32dp"
            android:layout_gravity="center"
            android:layout_margin="3dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>

    <!-- Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="@color/maroon_primary"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STUDENT GRADES"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/maroon_primary"
            android:letterSpacing="0.03"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/maroon_light"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- Grades List -->
    <!-- Grades List with Loading -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewGrades"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            android:background="@drawable/recycler_background"
            android:elevation="1dp"/>

        <ProgressBar
            android:id="@+id/progressBarLoading"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            android:elevation="8dp"
            android:indeterminateTint="@color/maroon_primary"
            android:indeterminateTintMode="src_in"/>

    </FrameLayout>

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveGrades"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾 SAVE ALL GRADES"
        android:textSize="17sp"
        android:textStyle="bold"
        android:paddingVertical="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_save"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/maroon_primary"
        app:rippleColor="@color/maroon_dark"
        android:textColor="@color/white"
        android:elevation="6dp"
        android:layout_marginTop="5dp"/>


</LinearLayout>