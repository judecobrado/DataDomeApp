<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".teacher.GradeInputActivity">

    <TextView
        android:id="@+id/tvGradeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[Period] Grades - [Class Name]"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvLoadingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading data..."
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:textColor="@android:color/holo_blue_dark"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewGrades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/> <Button
    android:id="@+id/btnSaveGrades"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="💾 Save All Grades"
    android:layout_marginTop="16dp"
    android:padding="12dp"
    android:textSize="18sp"/>

</LinearLayout>