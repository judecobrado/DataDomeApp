<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@android:color/white"
    android:layout_marginBottom="4dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAttStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:text="LastName, FirstName" />

        <TextView
            android:id="@+id/tvAttStudentId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            android:text="ID: DDS-0007" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/rgAttendanceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical">
        <RadioButton
            android:id="@+id/rbPresent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:button="@null"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/radio_selector"
            android:text="P"
            android:tag="Present" />

        <RadioButton
            android:id="@+id/rbLate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:button="@null"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/radio_selector"
            android:text="L"
            android:tag="Late" />

        <RadioButton
            android:id="@+id/rbExcused"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:button="@null"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/radio_selector"
            android:text="E"
            android:tag="Excused" />

        <RadioButton
            android:id="@+id/rbAbsent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:button="@null"
            android:gravity="center"
            android:background="@drawable/radio_selector"
            android:text="A"
            android:tag="Absent"/>
    </RadioGroup>

    <LinearLayout
        android:id="@+id/llRecitationControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnReciteMinus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="-"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/color_absent"
            android:padding="0dp"/>

        <TextView
            android:id="@+id/tvReciteScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:textAlignment="center"
            android:text="0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnRecitePlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/color_present"
            android:padding="0dp"/>

    </LinearLayout>

</LinearLayout>