<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".canteen.TopUpActivity">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cash-In / Top-Up Service"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvScanPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👋 Scan Student/Teacher RFID Tag to Start"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/rounded_border"
        android:backgroundTint="#FFF3E0"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/rounded_border"
        android:backgroundTint="#E8F5E9"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanned User Details:"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvStudentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User Info: N/A"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvCurrentBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Balance: ₱0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llTopUpForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Top-Up Amount (₱)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 50.00"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnConfirmTopUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONFIRM TOP-UP"
            android:backgroundTint="#4CAF50"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel / New Scan"
            android:backgroundTint="#F44336"
            android:textColor="@color/white"
            android:padding="12dp"/>

    </LinearLayout>

</LinearLayout>