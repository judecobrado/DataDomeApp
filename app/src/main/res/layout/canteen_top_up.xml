<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingHorizontal="24dp"
    android:paddingVertical="40dp"
    tools:context=".canteen.TopUpActivity">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ACCOUNT TOP-UP"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#212121"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp"/>

    <LinearLayout
        android:id="@+id/cardScanPrompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F8F8"
        android:paddingVertical="32dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvScanPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👋 Scan RFID Tag to Start"
            android:textSize="18sp"
            android:textColor="#7B1113"
            android:gravity="center"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardUserDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardScanPrompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT HOLDER"
            android:textStyle="normal"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvStudentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name and ID: N/A (Awaiting Scan)"
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT BALANCE"
            android:textStyle="normal"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvCurrentBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:fontFamily="sans-serif-black"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llTopUpForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/cardUserDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENTER CASH-IN AMOUNT"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxStrokeColor="#7B1113"
            app:hintTextColor="#7B1113"
            app:prefixText="₱ " app:prefixTextColor="#7B1113">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Amount "
                android:inputType="numberDecimal"
                android:textColor="#212121"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingVertical="18dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ⭐ INILIPAT DITO: Note tungkol sa balanse limitasyon, direkta sa ilalim ng input field. -->
        <TextView
            android:id="@+id/tvBalanceLimitNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: Maximum wallet balance is ₱3000.00"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textColor="@android:color/holo_red_dark"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmTopUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="CONFIRM TOP-UP"
            android:backgroundTint="#7B1113"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp" android:paddingVertical="18dp"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCEL / NEW SCAN"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#757575"
            android:paddingVertical="12dp"
            android:textStyle="normal"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>